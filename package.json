{
  "name": "babybargains-stock",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:local": "tsx scripts/dev-db.mts",
    "migrate": "tsx --env-file-if-exists=.env.local scripts/migrate.mts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed.mts",
    "reset": "tsx --env-file-if-exists=.env.local scripts/reset.mts",
    "verify": "tsx --env-file-if-exists=.env.local scripts/verify.mts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "mongodb": "^7.7.0",
    "next": "^16.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.0",
    "fast-check": "^4.10.2",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  }
}
